# Staging Environment Inventory
# REA DevOps Interactive Bible Backend - Staging Servers

[staging]
staging ansible_host=18.223.241.84 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/deployment_key
# Add more staging servers here as needed
# staging-app-02 ansible_host=YOUR_STAGING_SERVER_IP_2 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/deployment_key

[staging:vars]
# Environment identification
env_group=staging
env_name=staging

# Common staging variables
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_ssh_timeout=30
ansible_ssh_retries=3

# Backend-specific configurations
backend_only=true
api_only_deployment=true
high_availability=false