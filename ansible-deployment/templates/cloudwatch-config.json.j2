{
  "agent": {
    "metrics_collection_interval": {{ health_check_interval }},
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "{{ app_log_dir }}/{{ env_name }}.log",
            "log_group_name": "{{ cloudwatch_log_group }}",
            "log_stream_name": "{instance_id}-app-logs",
            "timezone": "UTC",
            "multi_line_start_pattern": "{timestamp_format}"
          },
          {
            "file_path": "{{ app_log_dir }}/{{ env_name }}.error.log",
            "log_group_name": "{{ cloudwatch_log_group }}",
            "log_stream_name": "{instance_id}-error-logs",
            "timezone": "UTC"
          },
          {
            "file_path": "{{ app_log_dir }}/{{ env_name }}_nginx_access.log",
            "log_group_name": "{{ cloudwatch_log_group }}", 
            "log_stream_name": "{instance_id}-nginx-access",
            "timezone": "UTC"
          },
          {
            "file_path": "{{ app_log_dir }}/{{ env_name }}_nginx_error.log",
            "log_group_name": "{{ cloudwatch_log_group }}",
            "log_stream_name": "{instance_id}-nginx-error", 
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "{{ cloudwatch_log_group }}",
            "log_stream_name": "{instance_id}-syslog",
            "timezone": "UTC"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "READevOps/{{ env_name | title }}",
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_iowait", 
          "cpu_usage_user",
          "cpu_usage_system"
        ],
        "metrics_collection_interval": {{ health_check_interval }},
        "resources": [
          "*"
        ],
        "totalcpu": false
      },
      "disk": {
        "measurement": [
          "used_percent"
        ],
        "metrics_collection_interval": {{ health_check_interval }},
        "resources": [
          "*"
        ]
      },
      "diskio": {
        "measurement": [
          "io_time",
          "read_bytes",
          "write_bytes",
          "reads",
          "writes"
        ],
        "metrics_collection_interval": {{ health_check_interval }},
        "resources": [
          "*"
        ]
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent"
        ],
        "metrics_collection_interval": {{ health_check_interval }}
      },
      "netstat": {
        "measurement": [
          "tcp_established",
          "tcp_time_wait"
        ],
        "metrics_collection_interval": {{ health_check_interval }}
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": {{ health_check_interval }}
      }
    }
  }
}