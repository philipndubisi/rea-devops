# {{ ansible_managed }}
# Environment Configuration for {{ app_name }} - {{ env_name | upper }}
# Generated on {{ ansible_date_time.iso8601 }}

# Application Environment
NODE_ENV={{ node_env }}
APP_ENV={{ env_name }}
PORT={{ app_port }}
APP_NAME={{ app_name }}

# API Configuration
API_VERSION={{ api_version | default('v1') }}
API_PREFIX={{ api_prefix | default('/api/v1') }}
API_BASE_URL={{ api_base_url }}

# Security Keys (Environment-Specific)
JWT_SECRET={{ jwt_secret_key }}
API_SECRET={{ api_secret_key }}
SESSION_SECRET={{ session_secret_key }}

# Database Configuration
MONGODB_URI=mongodb://{{ mongodb_username }}:{{ mongodb_password_env }}@localhost:{{ mongodb_port | default(27017) }}/{{ mongodb_database_name }}
DB_NAME={{ mongodb_database_name }}
DB_HOST={{ db_host | default('localhost') }}
DB_PORT={{ mongodb_port | default(27017) }}

# Redis Configuration (if used)
{% if redis_host is defined %}
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port | default(6379) }}
REDIS_URL=redis://{{ redis_host }}:{{ redis_port | default(6379) }}
{% endif %}

# Logging Configuration
LOG_LEVEL={{ log_level }}
LOG_DIR={{ app_log_dir }}
LOG_FORMAT={{ log_format | default('combined') }}

# Performance Settings
{% if env_name == 'production' %}
# Production Settings
MAX_CONNECTIONS={{ max_connections | default(1000) }}
CONNECTION_TIMEOUT={{ connection_timeout | default(30) }}
KEEPALIVE_TIMEOUT={{ keepalive_timeout | default(75) }}
PM2_INSTANCES={{ pm2_instances }}
{% else %}
# Staging/Development Settings
MAX_CONNECTIONS={{ max_connections | default(100) }}
CONNECTION_TIMEOUT={{ connection_timeout | default(10) }}
KEEPALIVE_TIMEOUT={{ keepalive_timeout | default(30) }}
PM2_INSTANCES={{ pm2_instances }}
DEBUG={{ debug_enabled | default(true) }}
{% endif %}

# CORS Configuration
{% for origin in cors_origins %}
CORS_ORIGIN_{{ loop.index }}={{ origin }}
{% endfor %}

# Health Check Configuration
HEALTH_CHECK_ENDPOINT={{ health_check_endpoint | default('/api/v1/health') }}
HEALTH_CHECK_INTERVAL={{ health_check_interval }}

# Rate Limiting
{% if rate_limit_enabled | default(false) %}
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX={{ rate_limit_max }}
RATE_LIMIT_WINDOW={{ rate_limit_window }}
{% else %}
RATE_LIMIT_ENABLED=false
{% endif %}

# SSL Configuration
SSL_ENABLED={{ ssl_enabled | default(false) }}
FORCE_HTTPS={{ force_https | default(false) }}

# AWS Configuration (if CloudWatch is used)
{% if vault_aws_credentials is defined and vault_aws_credentials[env_name] is defined %}
AWS_REGION={{ cloudwatch_region }}
AWS_ACCESS_KEY_ID={{ vault_aws_credentials[env_name].access_key_id }}
AWS_SECRET_ACCESS_KEY={{ vault_aws_credentials[env_name].secret_access_key }}
CLOUDWATCH_LOG_GROUP={{ cloudwatch_log_group }}
{% endif %}

# External Services
{% if vault_external_services is defined %}
{% for key, value in vault_external_services.items() %}
{% if env_name in key %}
{{ key | upper | replace(env_name + '_', '') | replace('_', '_') }}={{ value }}
{% endif %}
{% endfor %}
{% endif %}

# Environment-specific Overrides
{% if env_name == 'staging' %}
# Staging-specific variables
DEBUG_MODE=true
VERBOSE_LOGGING=true
TEST_MODE=true
{% elif env_name == 'production' %}
# Production-specific variables
DEBUG_MODE=false
VERBOSE_LOGGING=false
PERFORMANCE_MONITORING=true
ERROR_REPORTING=true
{% endif %}

# Application-specific variables from secrets file
{% if app_specific_vars is defined %}
{% for key, value in app_specific_vars.items() %}
{{ key }}={{ value }}
{% endfor %}
{% endif %}