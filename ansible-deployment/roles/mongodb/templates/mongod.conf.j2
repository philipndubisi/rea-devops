# MongoDB configuration file for {{ env_name }} environment
# {{ ansible_managed }}

# Storage configuration
storage:
  dbPath: /var/lib/mongodb
  journal:
    enabled: true

# System log configuration
systemLog:
  destination: file
  logAppend: true
  path: /var/log/mongodb/mongod.log
  logRotate: rotate

# Network interfaces
net:
  port: {{ mongodb_port | default(27017) }}
  bindIp: {{ mongodb_bind_ip | default('127.0.0.1') }}
  maxIncomingConnections: {{ mongodb_max_connections | default(65536) }}

# Process management
processManagement:
  timeZoneInfo: /usr/share/zoneinfo
  fork: true
  pidFilePath: /var/lib/mongodb/mongod.lock

# Security configuration
{% if mongodb_auth_enabled | default(true) %}
security:
  authorization: enabled
{% endif %}

# Replication (for production)
{% if env_name == 'production' and mongodb_replica_set is defined %}
replication:
  replSetName: {{ mongodb_replica_set }}
{% endif %}

# Sharding (if needed)
{% if mongodb_sharding_enabled | default(false) %}
sharding:
  clusterRole: {{ mongodb_cluster_role | default('shardsvr') }}
{% endif %}

# Operation profiling
operationProfiling:
  slowOpThresholdMs: {{ mongodb_slow_op_threshold | default(100) }}
  mode: {{ mongodb_profiling_mode | default('slowOp') }}

# Set parameter for {{ env_name }} environment
setParameter:
  enableLocalhostAuthBypass: {{ 'true' if env_name == 'staging' else 'false' }}