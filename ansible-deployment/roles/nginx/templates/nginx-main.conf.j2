# Dynamic Nginx Main Configuration with Environment-Specific Settings
# Generated by Ansible for {{ env_name }} environment
# Last updated: {{ ansible_date_time.iso8601 }}

user www-data;
worker_processes {{ nginx_worker_processes }};
pid /run/nginx.pid;
worker_rlimit_nofile {{ nginx_limits.worker_rlimit_nofile | default('65536') }};

events {
    worker_connections {{ nginx_worker_connections }};
    {% if env_name == 'production' %}
    use {{ nginx_limits.events_use | default('epoll') }};
    multi_accept {{ nginx_limits.multi_accept | default('on') }};
    {% else %}
    use epoll;
    multi_accept on;
    {% endif %}
}

http {
    # Basic Settings
    sendfile {{ nginx_optimization.sendfile | default('on') }};
    tcp_nopush {{ nginx_optimization.tcp_nopush | default('on') }};
    tcp_nodelay {{ nginx_optimization.tcp_nodelay | default('on') }};
    keepalive_timeout {{ nginx_keepalive_timeout }};
    types_hash_max_size 2048;
    server_names_hash_bucket_size 128;
    
    # File Cache Settings (Production Optimization)
    {% if env_name == 'production' %}
    open_file_cache {{ nginx_optimization.open_file_cache | default('max=200000 inactive=20s') }};
    open_file_cache_valid {{ nginx_optimization.open_file_cache_valid | default('30s') }};
    open_file_cache_min_uses {{ nginx_optimization.open_file_cache_min_uses | default('2') }};
    open_file_cache_errors {{ nginx_optimization.open_file_cache_errors | default('on') }};
    {% endif %}

    # MIME Types
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Dynamic Log Formats
    {% if log_format_type == 'json' %}
    log_format json_combined escape=json
        '{'
            '"time_local":"$time_local",'
            '"remote_addr":"$remote_addr",'
            '"remote_user":"$remote_user",'
            '"request":"$request",'
            '"status":"$status",'
            '"body_bytes_sent":"$body_bytes_sent",'
            '"request_time":"$request_time",'
            '"http_referrer":"$http_referer",'
            '"http_user_agent":"$http_user_agent",'
            '"http_x_forwarded_for":"$http_x_forwarded_for",'
            '"upstream_response_time":"$upstream_response_time",'
            '"upstream_addr":"$upstream_addr",'
            '"request_id":"$request_id"'
        '}';
    {% endif %}

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                   '$status $body_bytes_sent "$http_referer" '
                   '"$http_user_agent" "$http_x_forwarded_for" '
                   'rt=$request_time ut=$upstream_response_time '
                   'cs=$upstream_cache_status';

    log_format detailed '$remote_addr - $remote_user [$time_local] "$request" '
                       '$status $body_bytes_sent "$http_referer" '
                       '"$http_user_agent" "$http_x_forwarded_for" '
                       'rt=$request_time ut=$upstream_response_time '
                       'cs=$upstream_cache_status host=$host '
                       'scheme=$scheme server_name=$server_name '
                       'request_id=$request_id';

    # Dynamic Access and Error Logs
    {% if log_format_type == 'json' %}
    access_log {{ nginx_access_log }} json_combined;
    {% else %}
    access_log {{ nginx_access_log }} {{ log_format_type }};
    {% endif %}
    error_log {{ nginx_error_log }} {{ log_level }};

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level {{ gzip_compression_level }};
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/xml+rss
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Rate Limiting Zones (Environment-Specific)
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate={{ api_rate_limit }};
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate={{ auth_rate_limit }};
    limit_req_zone $binary_remote_addr zone=global_limit:10m rate={{ global_rate_limit }};
    
    # Connection Limiting
    limit_conn_zone $binary_remote_addr zone=conn_limit_per_ip:10m;
    limit_conn conn_limit_per_ip {{ '15' if env_name == 'production' else '50' }};

    # Client Settings
    client_max_body_size {{ client_max_body_size }};
    client_body_timeout {{ client_body_timeout }};
    client_header_timeout {{ client_header_timeout }};
    client_body_buffer_size {{ '128k' if env_name == 'production' else '16k' }};
    client_header_buffer_size {{ '8k' if env_name == 'production' else '1k' }};
    large_client_header_buffers {{ '8 64k' if env_name == 'production' else '4 32k' }};

    # Proxy Settings
    proxy_connect_timeout 60s;
    proxy_send_timeout {{ api_timeout }};
    proxy_read_timeout {{ proxy_timeout }};
    proxy_buffers {{ '16 64k' if env_name == 'production' else '8 32k' }};
    proxy_buffer_size {{ '128k' if env_name == 'production' else '64k' }};
    proxy_busy_buffers_size {{ '256k' if env_name == 'production' else '128k' }};

    # SSL Configuration
    ssl_protocols {{ ssl_protocols }};
    ssl_ciphers {{ ssl_ciphers }};
    ssl_prefer_server_ciphers {{ ssl_prefer_server_ciphers }};
    ssl_session_cache shared:SSL:{{ ssl_session_cache_size }};
    ssl_session_timeout {{ ssl_session_timeout }};
    ssl_session_tickets {{ ssl_session_tickets }};
    
    # SSL Security
    ssl_stapling {{ ssl_stapling }};
    ssl_stapling_verify {{ ssl_stapling_verify }};
    ssl_dhparam {{ ssl_dhparam_path }};
    
    # DNS Resolver for SSL
    resolver {{ dns_resolver }} valid=300s;
    resolver_timeout 5s;

    {% if enable_api_cache %}
    # Caching Configuration (Production)
    proxy_cache_path /var/cache/nginx/api levels=1:2 keys_zone=api_cache:{{ cache_zone_size }}
                     max_size={{ cache_max_size }} inactive={{ cache_inactive_time }}
                     use_temp_path=off;
    proxy_cache_path /var/cache/nginx/static levels=1:2 keys_zone=static_cache:{{ cache_zone_size }}
                     max_size={{ cache_max_size }} inactive={{ cache_inactive_time }}
                     use_temp_path=off;
    
    # Cache directories
    proxy_temp_path /var/cache/nginx/temp;
    
    # Cache key definition
    proxy_cache_key "$scheme$request_method$host$request_uri";
    {% endif %}

    # Security Headers (Global)
    add_header X-Frame-Options "{{ x_frame_options }}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "{{ referrer_policy }}" always;
    
    {% if env_name == 'production' %}
    # Production Security Headers
    {% for header_name, header_value in security_headers.items() %}
    add_header {{ header_name | replace('_', '-') | title }} "{{ header_value }}" always;
    {% endfor %}
    {% endif %}

    # Hide Nginx version
    server_tokens off;

    # Include site configurations
    include /etc/nginx/sites-enabled/*;
}