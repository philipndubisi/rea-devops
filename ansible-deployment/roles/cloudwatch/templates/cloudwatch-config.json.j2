{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/home/{{ deploy_user }}/.pm2/logs/{{ pm2_app_name }}-out.log",
            "log_group_name": "/ec2/{{ env_name }}/{{ app_name }}/{{ app_component }}",
            "log_stream_name": "{instance_id}/stdout",
            "timezone": "UTC"
          },
          {
            "file_path": "/home/{{ deploy_user }}/.pm2/logs/{{ pm2_app_name }}-error.log",
            "log_group_name": "/ec2/{{ env_name }}/{{ app_name }}/{{ app_component }}",
            "log_stream_name": "{instance_id}/stderr",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/{{ app_name }}_access.log",
            "log_group_name": "/ec2/{{ env_name }}/{{ app_name }}/nginx",
            "log_stream_name": "{instance_id}/access",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/{{ app_name }}_error.log",
            "log_group_name": "/ec2/{{ env_name }}/{{ app_name }}/nginx",
            "log_stream_name": "{instance_id}/error",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
