# REA DevOps Inventory Configuration
# Configure your server details here

[staging]
staging-server ansible_host=your-staging-server.com ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/staging_key

[production] 
production-server ansible_host=seisho.emerj.net ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/production_key

[all:vars]
# Global SSH settings
ansible_ssh_common_args='-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null'
ansible_python_interpreter=/usr/bin/python3

# Environment-specific groups
[staging:vars]
env_name=staging

[production:vars]
env_name=production